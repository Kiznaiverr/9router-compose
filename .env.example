TUNNEL_TOKEN=eyJh...

# 9Router Configuration
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me-to-strong-password
PORT=20128
NODE_ENV=production
DATA_DIR=/app/data

# Domain public kamu lewat Cloudflare (opsional tapi disarankan untuk web UI & sync)
